@@ -0,0 +1,226 @@
+/******************************************************************************
+This source code is licensed under the MIT license found in the
+LICENSE file in the root directory of this source tree.
+*******************************************************************************/
+
+#include "common/GraphData.h"
+#include <algorithm>
+#include <cctype>
+#include <fstream>
+#include <iostream>
+#include <set>
+#include <sstream>
+
+using namespace NetworkAnalytical;
+
+namespace {
+std::string trim(const std::string& input) {
+    const auto first = std::find_if_not(input.begin(), input.end(), [](unsigned char c) {
+        return std::isspace(c);
+    });
+    const auto last = std::find_if_not(input.rbegin(), input.rend(), [](unsigned char c) {
+        return std::isspace(c);
+    }).base();
+    return first < last ? std::string(first, last) : std::string();
+}
+
+std::vector<std::string> split_csv(const std::string& line) {
+    std::vector<std::string> fields;
+    std::stringstream stream(line);
+    std::string field;
+    while (std::getline(stream, field, ',')) {
+        fields.push_back(trim(field));
+    }
+    return fields;
+}
+}  // namespace
+
+GraphData::GraphData(const NetworkParser& parser)
+    : npus_count(parser.get_npus_counts_per_dim().at(0)),
+      default_bandwidth(parser.get_bandwidths_per_dim().at(0)),
+      default_latency(parser.get_latencies_per_dim().at(0)),
+      injection_latency(parser.get_graph_injection_latency()) {
+    load_adjacency(parser.get_graph_adjacency_matrix_path());
+    for (int src = 0; src < npus_count; ++src) {
+        for (int dest = 0; dest < npus_count; ++dest) {
+            if (adjacency[src][dest] != 0) {
+                edge_properties[{src, dest}] = {default_bandwidth, default_latency};
+            }
+        }
+    }
+    if (parser.get_graph_edge_properties_path().has_value()) {
+        load_edge_properties(parser.get_graph_edge_properties_path().value());
+    }
+    load_routes(parser.get_graph_routing_paths_path());
+}
+
+int GraphData::get_npus_count() const noexcept {
+    return npus_count;
+}
+
+Bandwidth GraphData::get_default_bandwidth() const noexcept {
+    return default_bandwidth;
+}
+
+Latency GraphData::get_injection_latency() const noexcept {
+    return injection_latency;
+}
+
+const std::vector<std::vector<int>>& GraphData::get_adjacency() const noexcept {
+    return adjacency;
+}
+
+const std::vector<DeviceId>& GraphData::route(const DeviceId src, const DeviceId dest) const noexcept {
+    if (src < 0 || src >= npus_count || dest < 0 || dest >= npus_count) {
+        fail("route endpoint is outside graph");
+    }
+    return routes[static_cast<size_t>(src) * npus_count + dest];
+}
+
+const GraphEdgeProperties& GraphData::edge(const DeviceId src, const DeviceId dest) const noexcept {
+    const auto found = edge_properties.find({src, dest});
+    if (found == edge_properties.end()) {
+        fail("route references missing directed edge " + std::to_string(src) + " -> " + std::to_string(dest));
+    }
+    return found->second;
+}
+
+void GraphData::load_adjacency(const std::string& path) {
+    std::ifstream input(path);
+    if (!input) {
+        fail("cannot open adjacency matrix: " + path);
+    }
+    std::string line;
+    while (std::getline(input, line)) {
+        if (trim(line).empty()) {
+            continue;
+        }
+        std::stringstream row_stream(line);
+        std::vector<int> row;
+        int value;
+        while (row_stream >> value) {
+            if (value != 0 && value != 1) {
+                fail("adjacency entries must be zero or one");
+            }
+            row.push_back(value);
+        }
+        adjacency.push_back(std::move(row));
+    }
+    if (adjacency.size() != static_cast<size_t>(npus_count)) {
+        fail("adjacency row count does not match npus_count");
+    }
+    for (int src = 0; src < npus_count; ++src) {
+        if (adjacency[src].size() != static_cast<size_t>(npus_count)) {
+            fail("adjacency matrix is not square");
+        }
+        if (adjacency[src][src] != 0) {
+            fail("adjacency matrix must not contain self edges");
+        }
+    }
+}
+
+void GraphData::load_routes(const std::string& path) {
+    std::ifstream input(path);
+    if (!input) {
+        fail("cannot open routing paths: " + path);
+    }
+    std::string line;
+    std::vector<std::string> route_lines;
+    while (std::getline(input, line)) {
+        line = trim(line);
+        if (!line.empty()) {
+            route_lines.push_back(line);
+        }
+    }
+    if (!route_lines.empty() && route_lines.front().front() != '[') {
+        route_lines.erase(route_lines.begin());
+    }
+    const auto expected = static_cast<size_t>(npus_count) * npus_count;
+    if (route_lines.size() != expected) {
+        fail("routing file must contain exactly npus_count^2 source-major paths");
+    }
+    routes.reserve(expected);
+    for (size_t index = 0; index < route_lines.size(); ++index) {
+        std::string normalized = route_lines[index];
+        for (char& character : normalized) {
+            if (character == '[' || character == ']' || character == ',') {
+                character = ' ';
+            }
+        }
+        std::stringstream path_stream(normalized);
+        std::vector<DeviceId> route;
+        DeviceId node;
+        while (path_stream >> node) {
+            route.push_back(node);
+        }
+        const auto src = static_cast<DeviceId>(index / npus_count);
+        const auto dest = static_cast<DeviceId>(index % npus_count);
+        if (route.empty() || route.front() != src || route.back() != dest) {
+            fail("route endpoints do not match source-major position at " + std::to_string(src) + " -> " +
+                 std::to_string(dest));
+        }
+        std::set<DeviceId> visited;
+        for (const auto current : route) {
+            if (current < 0 || current >= npus_count || !visited.insert(current).second) {
+                fail("route contains an invalid or repeated device");
+            }
+        }
+        if (src == dest && route.size() != 1) {
+            fail("self route must contain only its endpoint");
+        }
+        for (size_t hop = 0; hop + 1 < route.size(); ++hop) {
+            (void)edge(route[hop], route[hop + 1]);
+        }
+        routes.push_back(std::move(route));
+    }
+}
+
+void GraphData::load_edge_properties(const std::string& path) {
+    std::ifstream input(path);
+    if (!input) {
+        fail("cannot open edge properties: " + path);
+    }
+    std::string line;
+    if (!std::getline(input, line)) {
+        fail("edge properties file is empty");
+    }
+    const auto header = split_csv(line);
+    auto column = [&](const std::string& name) -> size_t {
+        const auto found = std::find(header.begin(), header.end(), name);
+        if (found == header.end()) {
+            fail("edge properties is missing column " + name);
+        }
+        return static_cast<size_t>(std::distance(header.begin(), found));
+    };
+    const auto src_col = column("src");
+    const auto dest_col = column("dst");
+    const auto bandwidth_col = column("bandwidth_GBps");
+    const auto latency_col = column("latency_ns");
+    const auto max_col = std::max({src_col, dest_col, bandwidth_col, latency_col});
+    while (std::getline(input, line)) {
+        if (trim(line).empty()) {
+            continue;
+        }
+        const auto fields = split_csv(line);
+        if (fields.size() <= max_col) {
+            fail("edge properties row has too few columns");
+        }
+        try {
+            const auto src = std::stoi(fields[src_col]);
+            const auto dest = std::stoi(fields[dest_col]);
+            const auto bandwidth = std::stod(fields[bandwidth_col]);
+            const auto latency = std::stod(fields[latency_col]);
+            if (bandwidth <= 0 || latency < 0 || edge_properties.find({src, dest}) == edge_properties.end()) {
+                fail("edge properties contains an invalid or non-existent directed edge");
+            }
+            edge_properties[{src, dest}] = {bandwidth, latency};
+        } catch (const std::exception&) {
+            fail("edge properties contains a non-numeric value");
+        }
+    }
+}
+
+[[noreturn]] void GraphData::fail(const std::string& message) {
+    std::cerr << "[Error] (network/analytical/graph) " << message << std::endl;
+    std::exit(-1);
+}
