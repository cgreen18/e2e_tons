+#include "congestion_aware/Graph.h"
+
+using namespace NetworkAnalytical;
+using namespace NetworkAnalyticalCongestionAware;
+
+Graph::Graph(const NetworkParser& parser) : graph(parser) {
+    npus_count = graph.get_npus_count();
+    devices_count = npus_count;
+    dims_count = 1;
+    npus_count_per_dim = {npus_count};
+    bandwidth_per_dim = {graph.get_default_bandwidth()};
+    instantiate_devices();
+    const auto& adjacency = graph.get_adjacency();
+    for (int src = 0; src < npus_count; ++src) {
+        for (int dest = 0; dest < npus_count; ++dest) {
+            if (adjacency[src][dest] != 0) {
+                const auto& properties = graph.edge(src, dest);
+                connect(src, dest, properties.bandwidth, properties.latency, false);
+            }
+        }
+    }
+}
+
+Route Graph::route(const DeviceId src, const DeviceId dest) const noexcept {
+    Route route;
+    for (const auto device : graph.route(src, dest)) {
+        route.push_back(devices[device]);
+    }
+    return route;
+}
+
+Latency Graph::get_injection_latency() const noexcept {
+    return graph.get_injection_latency();
+}
+
+const GraphData& Graph::get_graph_data() const noexcept {
+    return graph;
+}
