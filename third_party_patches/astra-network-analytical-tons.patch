+#include <limits>
+
+using namespace NetworkAnalytical;
+using namespace NetworkAnalyticalCongestionUnaware;
+
+Graph::Graph(const NetworkParser& parser) : graph(parser) {
+    npus_count = graph.get_npus_count();
+    dims_count = 1;
+    npus_count_per_dim = {npus_count};
+    bandwidth_per_dim = {graph.get_default_bandwidth()};
+}
+
+EventTime Graph::send(const DeviceId src, const DeviceId dest, const ChunkSize chunk_size) const noexcept {
+    assert(src != dest);
+    assert(chunk_size > 0);
+    const auto& path = graph.route(src, dest);
+    auto latency = graph.get_injection_latency();
+    auto bottleneck_bandwidth = std::numeric_limits<Bandwidth>::max();
+    for (size_t hop = 0; hop + 1 < path.size(); ++hop) {
+        const auto& properties = graph.edge(path[hop], path[hop + 1]);
+        latency += properties.latency;
+        bottleneck_bandwidth = std::min(bottleneck_bandwidth, properties.bandwidth);
+    }
+    const auto serialization = static_cast<double>(chunk_size) / bw_GBps_to_Bpns(bottleneck_bandwidth);
+    return static_cast<EventTime>(latency + serialization);
+}
+
+const GraphData& Graph::get_graph_data() const noexcept {
+    return graph;
+}
