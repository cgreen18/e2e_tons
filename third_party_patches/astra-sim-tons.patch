+#include "astra-sim/workload/Statistics.hh"
+
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+namespace {
+
+void write_varint32(std::ostream& output, uint32_t value) {
+    while (value > 0x7f) {
+        output.put(static_cast<char>((value & 0x7f) | 0x80));
+        value >>= 7;
+    }
+    output.put(static_cast<char>(value));
+}
+
+template <typename Message>
+void write_message(std::ostream& output, const Message& message) {
+    const auto serialized = message.SerializeAsString();
+    write_varint32(output, static_cast<uint32_t>(serialized.size()));
+    output.write(serialized.data(), serialized.size());
+}
+
+void add_collective_type(ChakraProtoMsg::Node& node, int64_t comm_type) {
+    auto* const attribute = node.add_attr();
+    attribute->set_name("comm_type");
+    attribute->set_int64_val(comm_type);
+}
+
+class TemporaryTrace {
+  public:
+    TemporaryTrace() {
+        const auto timestamp = std::chrono::steady_clock::now()
+                                   .time_since_epoch()
+                                   .count();
+        path = std::filesystem::temp_directory_path() /
+            ("astra-statistics-test-" + std::to_string(timestamp) + ".et");
+
+        std::ofstream output(path, std::ios::binary);
+        ChakraProtoMsg::GlobalMetadata metadata;
+        metadata.set_version("0.0.4");
+        write_message(output, metadata);
+
+        add_node(output, 1, ChakraProtoMsg::COMM_COLL_NODE,
+                 ChakraProtoMsg::ALL_GATHER);
+        add_node(output, 2, ChakraProtoMsg::COMM_COLL_NODE,
+                 ChakraProtoMsg::ALL_REDUCE);
+        add_node(output, 3, ChakraProtoMsg::COMM_COLL_NODE,
+                 ChakraProtoMsg::ALL_GATHER);
+        add_node(output, 4, ChakraProtoMsg::COMM_COLL_NODE, 99);
+        add_node(output, 5, ChakraProtoMsg::COMM_COLL_NODE);
+        add_node(output, 6, ChakraProtoMsg::COMM_SEND_NODE);
+    }
+
+    ~TemporaryTrace() {
+        std::error_code error;
+        std::filesystem::remove(path, error);
+    }
+
+    std::filesystem::path path;
+
+  private:
+    static void add_node(
+        std::ostream& output,
+        uint64_t id,
+        ChakraProtoMsg::NodeType type,
+        const std::optional<int64_t>& comm_type = std::nullopt) {
+        ChakraProtoMsg::Node node;
+        node.set_id(id);
+        node.set_name("statistics_test_node_" + std::to_string(id));
+        node.set_type(type);
+        if (comm_type.has_value()) {
+            add_collective_type(node, comm_type.value());
+        }
+        write_message(output, node);
+    }
+};
+
+}  // namespace
+
+TEST(StatisticsTest, AggregatesCollectiveOperatorsByResolvedType) {
+    TemporaryTrace trace;
+    Chakra::ETFeeder feeder(trace.path.string());
+    AstraSim::Statistics statistics(nullptr);
+
+    const auto record = [&](uint64_t id,
+                            AstraSim::Tick start,
+                            AstraSim::Tick end,
+                            uint64_t bytes) {
+        const auto node = feeder.lookupNode(id);
+        statistics.record_start(node, start);
+        statistics.get_operator_statistics(id).comm_size = bytes;
+        statistics.record_end(node, end);
+    };
+
+    record(1, 10, 30, 100);
+    record(2, 40, 52, 64);
+    record(3, 60, 65, 150);
+    record(4, 70, 79, 3);
+    record(5, 80, 84, 7);
+    record(6, 90, 100, 1'000);
+
+    const auto collectives = statistics.get_collective_statistics();
+    ASSERT_EQ(collectives.size(), 3);
+
+    EXPECT_EQ(collectives[0].comm_type, "ALL_GATHER");
+    EXPECT_EQ(collectives[0].count, 2);
+    EXPECT_EQ(collectives[0].bytes, 250);
+    EXPECT_EQ(collectives[0].time_ns, 25);
+
+    EXPECT_EQ(collectives[1].comm_type, "ALL_REDUCE");
+    EXPECT_EQ(collectives[1].count, 1);
+    EXPECT_EQ(collectives[1].bytes, 64);
+    EXPECT_EQ(collectives[1].time_ns, 12);
+
+    EXPECT_EQ(collectives[2].comm_type, "UNKNOWN");
+    EXPECT_EQ(collectives[2].count, 2);
+    EXPECT_EQ(collectives[2].bytes, 10);
+    EXPECT_EQ(collectives[2].time_ns, 13);
+}
