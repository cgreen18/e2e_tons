+std::vector<Statistics::CollectiveStatistics>
+Statistics::get_collective_statistics() const {
+    std::map<std::string, CollectiveStatistics> aggregate_by_type;
+    for (const auto& [node_id, stat] : operator_statistics) {
+        if (!stat.collective_comm_type.has_value()) {
+            continue;
+        }
+        const auto& comm_type = stat.collective_comm_type.value();
+        auto& aggregate = aggregate_by_type[comm_type];
+        aggregate.comm_type = comm_type;
+        ++aggregate.count;
+        aggregate.bytes += stat.comm_size.value_or(0);
+        aggregate.time_ns += stat.end_time - stat.start_time;
+    }
+
+    std::vector<CollectiveStatistics> result;
+    result.reserve(aggregate_by_type.size());
+    for (const auto& [comm_type, aggregate] : aggregate_by_type) {
+        result.push_back(aggregate);
+    }
+    return result;
+}
