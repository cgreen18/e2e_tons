+
+DataSet* Sys::generate_structural_collective(
+    uint64_t size,
+    vector<bool> involved_dimensions,
+    CommunicatorGroup* communicator_group,
+    int explicit_priority,
+    uint64_t workload_node_id,
+    ComType collective_type) {
+    vector<CollectiveImpl*> implementation_per_dimension =
+        collective_impl_lookup->get_collective_impl_for_communicator(
+            collective_type, workload_node_id,
+            communicator_group == nullptr ? default_communicator()
+                                          : communicator_group->involved_NPUs);
+    if (implementation_per_dimension.empty() ||
+        implementation_per_dimension[0]->type !=
+            CollectiveImplType::CustomCollectiveImpl) {
+        LoggerFactory::get_logger("system")->critical(
+            "Broadcast/Reduce require a custom collective algorithm; none is "
+            "registered for this communicator");
+        exit(1);
+    }
+    return generate_collective(size, nullptr, implementation_per_dimension,
+                               involved_dimensions, collective_type,
+                               explicit_priority, communicator_group);
+}
