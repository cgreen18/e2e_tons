+    std::vector<CollectiveImpl*>
+    CollectiveImplLookup::get_collective_impl_for_communicator(
+        ComType comm_type,
+        uint64_t workload_node_id,
+        const std::vector<int>& involved_NPUs,
+        BypassRule bypass_rule) {
+
+        if (bypass_rule != BypassRule::BYPASS_ALL_CUSTOM &&
+            !involved_NPUs.empty()) {
+            // A per-node override still wins, matching the priority order
+            // documented on this class.
+            if (bypass_rule != BypassRule::BYPASS_PERNODE_CUSTOM) {
+                auto it = per_node_custom_impl.find(
+                    static_cast<int>(workload_node_id));
+                if (it != per_node_custom_impl.end()) {
+                    return std::vector<CollectiveImpl*>{it->second};
+                }
+            }
+
+            std::vector<int> key = involved_NPUs;
+            std::sort(key.begin(), key.end());
+
+            auto exact = per_communicator_custom_impl.find(comm_type);
+            if (exact != per_communicator_custom_impl.end()) {
+                auto hit = exact->second.find(key);
+                if (hit != exact->second.end()) {
+                    return std::vector<CollectiveImpl*>{hit->second};
+                }
+            }
+
+            auto sized = per_communicator_size_custom_impl.find(comm_type);
+            if (sized != per_communicator_size_custom_impl.end()) {
+                auto hit = sized->second.find(key.size());
+                if (hit != sized->second.end()) {
+                    return std::vector<CollectiveImpl*>{hit->second};
+                }
+            }
+        }
+
+        return get_collective_impl(comm_type, workload_node_id, bypass_rule);
+    }
+
+    bool CollectiveImplLookup::has_custom_impl_for_communicator(
+        ComType comm_type,
+        uint64_t workload_node_id,
+        const std::vector<int>& involved_NPUs) {
+
+        if (per_node_custom_impl.find(static_cast<int>(workload_node_id)) !=
+            per_node_custom_impl.end()) {
+            return true;
+        }
+        if (global_custom_impl_per_coll.find(comm_type) !=
+            global_custom_impl_per_coll.end()) {
+            return true;
+        }
+        std::vector<int> key = involved_NPUs;
+        std::sort(key.begin(), key.end());
+        auto exact = per_communicator_custom_impl.find(comm_type);
+        if (exact != per_communicator_custom_impl.end() &&
+            exact->second.find(key) != exact->second.end()) {
+            return true;
+        }
+        auto sized = per_communicator_size_custom_impl.find(comm_type);
+        if (sized != per_communicator_size_custom_impl.end() &&
+            sized->second.find(key.size()) != sized->second.end()) {
+            return true;
+        }
+        return false;
+    }
