@@ -0,0 +1,98 @@
+/******************************************************************************
+This source code is licensed under the MIT license found in the
+LICENSE file in the root directory of this source tree.
+*******************************************************************************/
+
+#include "common/StructuredOutput.hh"
+
+#include <algorithm>
+#include <fstream>
+#include <iomanip>
+#include <stdexcept>
+#include <tuple>
+
+#include "astra-sim/system/Sys.hh"
+#include "astra-sim/workload/Statistics.hh"
+#include "astra-sim/workload/Workload.hh"
+
+using NetworkAnalyticalCongestionAware::DirectedLinkStatistics;
+
+namespace AstraSimAnalytical {
+
+void write_structured_statistics(
+    const std::string& filename,
+    const std::string& backend,
+    const AstraSim::Tick simulation_end,
+    const std::vector<AstraSim::Sys*>& systems,
+    const std::vector<DirectedLinkStatistics>& unsorted_links) {
+    if (filename.empty()) {
+        return;
+    }
+    std::ofstream output(filename);
+    if (!output) {
+        throw std::runtime_error("cannot open statistics output: " + filename);
+    }
+    const bool complete = std::all_of(
+        systems.begin(), systems.end(),
+        [](const AstraSim::Sys* system) { return system->workload->is_finished; });
+    output << "{\n  \"schema_version\": 1,\n"
+           << "  \"backend\": \"" << backend << "\",\n"
+           << "  \"simulation_end_ns\": " << simulation_end << ",\n"
+           << "  \"complete\": " << (complete ? "true" : "false") << ",\n"
+           << "  \"ranks\": [\n";
+    for (size_t rank = 0; rank < systems.size(); ++rank) {
+        const auto* workload = systems[rank]->workload;
+        const auto* stats = workload->stats;
+        using Type = AstraSim::Statistics::OperatorStatistics::OperatorType;
+        const auto compute = stats->get_type_time(Type::GPU);
+        const auto communication = stats->get_type_time(Type::COMM);
+        const auto overlap = stats->get_comp_comm_overlap();
+        const auto exposed = communication > overlap ? communication - overlap : 0;
+        const auto collectives = stats->get_collective_statistics();
+        output << "    {\"rank\": " << rank
+               << ", \"complete\": "
+               << (workload->is_finished ? "true" : "false")
+               << ", \"wall_time_ns\": " << stats->get_wall_time()
+               << ", \"compute_time_ns\": " << compute
+               << ", \"communication_time_ns\": " << communication
+               << ", \"exposed_communication_time_ns\": " << exposed
+               << ", \"overlap_time_ns\": " << overlap
+               << ", \"collectives\": [";
+        for (size_t index = 0; index < collectives.size(); ++index) {
+            const auto& collective = collectives[index];
+            output << "{\"comm_type\": \"" << collective.comm_type
+                   << "\", \"count\": " << collective.count
+                   << ", \"bytes\": " << collective.bytes
+                   << ", \"time_ns\": " << collective.time_ns << "}"
+                   << (index + 1 == collectives.size() ? "" : ", ");
+        }
+        output << "]}"
+               << (rank + 1 == systems.size() ? "\n" : ",\n");
+    }
+    output << "  ],\n  \"links\": [\n";
+    auto links = unsorted_links;
+    std::sort(links.begin(), links.end(), [](const auto& left, const auto& right) {
+        return std::tie(left.src, left.dest) < std::tie(right.src, right.dest);
+    });
+    output << std::setprecision(10);
+    for (size_t index = 0; index < links.size(); ++index) {
+        const auto& link = links[index];
+        const double utilization = simulation_end == 0
+            ? 0.0
+            : static_cast<double>(link.serialization_busy_time) /
+                  static_cast<double>(simulation_end);
+        output << "    {\"src\": " << link.src << ", \"dst\": " << link.dest
+               << ", \"bytes\": " << link.transmitted_bytes
+               << ", \"chunks\": " << link.transmitted_chunks
+               << ", \"serialization_busy_ns\": " << link.serialization_busy_time
+               << ", \"queued_chunks\": " << link.queued_chunks
+               << ", \"total_queue_wait_ns\": " << link.total_queue_wait
+               << ", \"max_queue_wait_ns\": " << link.max_queue_wait
+               << ", \"maximum_queue_depth\": " << link.max_queue_depth
+               << ", \"utilization\": " << utilization << "}"
+               << (index + 1 == links.size() ? "\n" : ",\n");
+    }
+    output << "  ]\n}\n";
+}
+
+}  // namespace AstraSimAnalytical
