+    // Maps the Chakra collective names used in the per-communicator YAML onto
+    // ASTRA's internal ComType.  The YAML deliberately uses Chakra's spelling
+    // so the file can be generated straight from a trace pre-scan.
+    static const std::map<std::string, ComType>& collective_name_to_comtype() {
+        static const std::map<std::string, ComType> table = {
+            {"ALL_REDUCE", ComType::All_Reduce},
+            {"ALL_GATHER", ComType::All_Gather},
+            {"REDUCE_SCATTER", ComType::Reduce_Scatter},
+            {"ALL_TO_ALL", ComType::All_to_All},
+            {"BROADCAST", ComType::Broadcast},
+            {"REDUCE", ComType::Reduce},
+        };
+        return table;
