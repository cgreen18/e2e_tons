+uint64_t CustomAlgorithm::get_msg_size(
+    shared_ptr<Chakra::FeederV3::ETFeederNode> node) const {
+    auto logger = AstraSim::LoggerFactory::get_logger(
+        "system::astraccl::custom_collectives");
+    const auto legacy_size = [&]() -> uint64_t {
+        const uint64_t fallback = node->get_attr<uint64_t>("comm_size", 0);
+        if (fallback == 0) {
+            throw runtime_error(
+                "custom collective node is missing valid symbolic chunk "
+                "attributes and a positive comm_size fallback");
+        }
+        logger->warn(
+            "Custom schedule {} node {} uses deprecated hard-coded comm_size",
+            et_filename, node->id());
+        return fallback;
+    };
+    const bool has_workload_chunks = node->has_attr("workload_chunk_cnt");
+    const bool has_legacy_chunks = node->has_attr("total_chunk_cnt");
+    if (!node->has_attr("msg_chunk_cnt") ||
+        !node->has_attr("msg_chunk_idx") ||
+        (!has_workload_chunks && !has_legacy_chunks)) {
+        return legacy_size();
+    }
+
+    const int64_t message_chunks_raw = node->get_attr<int64_t>("msg_chunk_cnt");
+    const int64_t message_index_raw = node->get_attr<int64_t>("msg_chunk_idx");
+    int64_t workload_chunks_raw = has_workload_chunks
+        ? node->get_attr<int64_t>("workload_chunk_cnt")
+        : node->get_attr<int64_t>("total_chunk_cnt");
+    if (message_chunks_raw <= 0 || message_index_raw < 0 ||
+        workload_chunks_raw <= 0) {
+        return legacy_size();
+    }
+    const uint64_t message_chunks = static_cast<uint64_t>(message_chunks_raw);
+    const uint64_t message_index = static_cast<uint64_t>(message_index_raw);
+    uint64_t workload_chunks = static_cast<uint64_t>(workload_chunks_raw);
+
+    // Legacy all-gather converters described the full output layout.  New
+    // schedules explicitly describe the per-rank workload input layout.
+    if (!has_workload_chunks && this->comType == ComType::All_Gather) {
+        const uint64_t involved = comm_group == nullptr
+            ? static_cast<uint64_t>(sys->all_sys.size())
+            : static_cast<uint64_t>(comm_group->involved_NPUs.size());
+        if (involved == 0 || workload_chunks % involved != 0) {
+            throw runtime_error(
+                "legacy all-gather chunk count is not divisible by communicator size");
+        }
+        workload_chunks /= involved;
+    }
+    if (workload_chunks == 0 || message_chunks == 0 ||
+        message_index >= workload_chunks ||
+        message_chunks > workload_chunks - message_index) {
+        throw runtime_error("custom collective has an invalid logical chunk range");
+    }
+
+    const uint64_t base = data_size / workload_chunks;
+    const uint64_t remainder = data_size % workload_chunks;
+    const uint64_t end = message_index + message_chunks;
+    const uint64_t extras =
+        std::min(end, remainder) - std::min(message_index, remainder);
+    return base * message_chunks + extras;
 }
 
