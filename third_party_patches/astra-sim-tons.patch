+
+    void CollectiveImplLookup::parse_per_communicator_yaml_file(
+        const std::string& yaml_filepath) {
+        YAML::Node root;
+        try {
+            root = YAML::LoadFile(yaml_filepath);
+        } catch (const YAML::BadFile& e) {
+            throw std::runtime_error(
+                "Failed to open per-communicator YAML file: " + yaml_filepath);
+        } catch (const YAML::ParserException& e) {
+            throw std::runtime_error(
+                std::string("per-communicator YAML parse error: ") + e.what());
+        }
+        if (!root || !root.IsMap()) {
+            throw std::runtime_error(
+                "per-communicator YAML must map a collective name to its groups");
+        }
+
+        for (const auto& entry : root) {
+            const std::string collective = entry.first.as<std::string>();
+            const auto it = collective_name_to_comtype().find(collective);
+            if (it == collective_name_to_comtype().end()) {
+                throw std::runtime_error(
+                    "per-communicator YAML has an unknown collective name: " +
+                    collective);
+            }
+            const ComType comm_type = it->second;
+            const YAML::Node& body = entry.second;
+            if (!body || !body.IsMap()) {
+                throw std::runtime_error(
+                    "per-communicator YAML entry " + collective +
+                    " must be a mapping with 'groups' and/or 'sizes'");
+            }
+
+            if (body["groups"]) {
+                if (!body["groups"].IsSequence()) {
+                    throw std::runtime_error(
+                        "per-communicator YAML 'groups' must be a sequence");
+                }
+                for (const auto& group : body["groups"]) {
+                    if (!group["ranks"] || !group["ranks"].IsSequence() ||
+                        !group["algorithm"]) {
+                        throw std::runtime_error(
+                            "per-communicator YAML group needs 'ranks' and "
+                            "'algorithm'");
+                    }
+                    std::vector<int> ranks =
+                        group["ranks"].as<std::vector<int>>();
+                    if (ranks.empty()) {
+                        throw std::runtime_error(
+                            "per-communicator YAML group has no ranks");
+                    }
+                    // Membership is the lookup key, so it must be canonical.
+                    // CommunicatorGroup sorts involved_NPUs the same way.
+                    std::sort(ranks.begin(), ranks.end());
+                    if (std::adjacent_find(ranks.begin(), ranks.end()) !=
+                        ranks.end()) {
+                        throw std::runtime_error(
